PORT=5000
JWT_SECRET=your_jwt_secret_here

# Database (SQL Server)
# Run `npm run setup` to auto-create the database and seed data
DB_SERVER=localhost
DB_DATABASE=PlantShopDB
DB_USER=sa
DB_PASSWORD=your_db_password
DB_TRUST_CERT=true

# Frontend origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:5176,http://localhost:3000

# Shop info for print labels (seed defaults for admin print settings)
SHOP_NAME=PlantShop
SHOP_PHONE=0900 000 000
SHOP_ADDRESS=123 Duong Xanh, Quan 1, TP. Ho Chi Minh

# Shipping config (fallback when no ShippingZone row matches)
SHOP_PROVINCE=TP. Hồ Chí Minh
SHOP_DISTRICT=Quận 1
SHIPPING_STANDARD_FEE=30000
SHIPPING_STANDARD_FREE_THRESHOLD=500000
SHIPPING_EXPRESS_FEE=30000
SHIPPING_SAMEDAY_FEE=60000

# VNPay config
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_BANK_CODE=
# Frontend route that receives VNPay redirect, e.g. http://localhost:5173/payment/vnpay-return
VNPAY_RETURN_URL=

# PayOS config
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
BASE_URL=http://localhost:5173

# Bank transfer display config
BANK_ACCOUNT_NAME=YOUR_BANK_ACCOUNT_NAME
BANK_ACCOUNT_NUMBER=000000000000
BANK_NAME=YOUR_BANK_NAME

# OpenRouter AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_PRODUCT_ADVISOR_MODEL=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=PlantWeb Admin

# OAuth
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload protection
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX=20

# Wholesale lead protection
WHOLESALE_RATE_LIMIT_WINDOW_MS=600000
WHOLESALE_RATE_LIMIT_MAX=5

# Wholesale notifications
# Supported types: slack, json
WHOLESALE_NOTIFY_WEBHOOK_TYPE=slack
WHOLESALE_NOTIFY_WEBHOOK_URL=
